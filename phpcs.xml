<?xml version="1.0"?>
<ruleset name="Finzo Coding Standards">
    <description>PSR-12 coding standard for Finzo Project</description>

    <!-- Scan these directories -->
    <file>app</file>
    <file>config</file>
    <file>bootstrap</file>
    <file>routes</file>
    <file>tests</file>
    <file>bin</file>

    <!-- Exclude vendor directory -->
    <exclude-pattern>vendor/</exclude-pattern>

    <!-- Use PSR-12 as a base -->
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>

    <!-- Output format -->
    <arg name="colors"/>
    <arg value="sp"/>
</ruleset>
