<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Finzo/
    
    # Bridge legacy frontend API calls to the new Front Controller
    RewriteRule ^public/assets/api/(.*)$ public/api/index.php [L,QSA]
    RewriteRule ^public/api/(.*)$ public/api/index.php [L,QSA]
    RewriteRule ^api/(.*)$ public/api/index.php [L,QSA]
    RewriteRule ^app/Controllers/(.*)$ public/api/index.php [L,QSA]
    
    # Bridge uploads to the public/uploads folder
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L,QSA]
    
    # Bridge legacy view redirects to the resources directory
    RewriteRule ^views/(.*)$ resources/views/$1 [L,QSA]
</IfModule>
