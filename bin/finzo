#!/usr/bin/env php
<?php
/**
 * Finzo CLI - Migration and Seeder Tool
 */

require_once __DIR__ . '/../config/config.php';
require_once __DIR__ . '/../database/Migrator.php';

require_once __DIR__ . '/../database/BcdrManager.php';

use Database\Migrator;
use Database\BcdrManager;

$dsn = "mysql:host=" . DB_HOST . ";dbname=" . DB_NAME . ";charset=utf8mb4";
$options = [
    PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    PDO::ATTR_EMULATE_PREPARES   => false,
];

try {
    $pdo = new PDO($dsn, DB_USER, DB_PASS, $options);
} catch (PDOException $e) {
    die("Database connection failed: " . $e->getMessage() . "\n");
}

$migrator = new Migrator($pdo, __DIR__ . '/../database/migrations', __DIR__ . '/../database/seeds');
$bcdr = new BcdrManager($pdo);

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'migrate':
        // Phase 11: Migration Safety - Automatic backup before schema changes
        echo "Creating pre-migration safety backup...\n";
        $bcdr->backup('schema');
        try {
            $migrator->migrate();
        } catch (Exception $e) {
            echo "Migration Failed: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;
    
    case 'rollback':
        $migrator->rollback();
        break;
    
    case 'reset':
        $migrator->reset();
        break;
        
    case 'seed':
        $type = $argv[2] ?? 'system';
        $migrator->seed($type);
        break;

    case 'backup':
        $type = $argv[2] ?? 'full';
        $bcdr->backup($type);
        break;

    case 'restore':
        $file = $argv[2] ?? null;
        if (!$file) {
            die("Usage: php bin/finzo restore <backup_file>\n");
        }
        $bcdr->restore($file);
        break;

    case 'validate':
        $bcdr->validateIntegrity();
        break;

    case 'monitor':
        echo "Finzo Enterprise Database Monitor\n";
        echo "---------------------------------\n";
        
        // Uptime
        $stmt = $pdo->query("SHOW GLOBAL STATUS LIKE 'Uptime'");
        $uptime = $stmt->fetch(PDO::FETCH_ASSOC)['Value'];
        echo "Uptime: " . gmdate("H:i:s", (int)$uptime) . "\n";
        
        // Connections
        $stmt = $pdo->query("SHOW GLOBAL STATUS LIKE 'Threads_connected'");
        $threads = $stmt->fetch(PDO::FETCH_ASSOC)['Value'];
        echo "Active Connections: {$threads}\n";
        
        // Storage
        try {
            $stmt = $pdo->query("SELECT SUM(size_mb) as total_size FROM vw_monitoring_storage");
            $size = $stmt->fetchColumn();
            echo "Total Storage Size: {$size} MB\n";
        } catch (Exception $e) {
            echo "Total Storage Size: (Observability views not migrated yet)\n";
        }
        
        // Ledger Health
        try {
            $stmt = $pdo->query("SELECT COUNT(*) FROM vw_monitoring_ledger_health");
            $unbalanced = $stmt->fetchColumn();
            if ($unbalanced > 0) {
                echo "\n[WARNING] {$unbalanced} Unbalanced Journals Detected!\n";
            } else {
                echo "\n[OK] Ledger is perfectly balanced.\n";
            }
        } catch (Exception $e) {}
        
        break;

    case 'prune':
        echo "Starting data pruning for compliance (GDPR Data Minimization)...\n";
        try {
            // Delete audit logs older than 365 days
            $stmt = $pdo->prepare("DELETE FROM audit_log WHERE created_at < DATE_SUB(NOW(), INTERVAL 365 DAY)");
            $stmt->execute();
            $deletedAudit = $stmt->rowCount();
            echo "Deleted {$deletedAudit} audit log entries older than 365 days.\n";

            // Delete rejected KYC applications older than 90 days (Privacy)
            $stmt = $pdo->prepare("DELETE FROM users WHERE status = 'rejected' AND is_deleted = 1 AND deleted_at < DATE_SUB(NOW(), INTERVAL 90 DAY)");
            $stmt->execute();
            $deletedKyc = $stmt->rowCount();
            echo "Deleted {$deletedKyc} rejected KYC user profiles older than 90 days.\n";
            
        } catch (Exception $e) {
            echo "Pruning failed: " . $e->getMessage() . "\n";
        }
        break;

    case 'queue:work':
        echo "Starting Finzo Enterprise Queue Worker...\n";
        $queue = $argv[2] ?? 'default';
        $manager = \App\Shared\Core\Queue\QueueManager::getInstance();
        
        while (true) {
            try {
                $pdo->beginTransaction();
                
                // Get next available job and lock it (FOR UPDATE)
                $stmt = $pdo->prepare("SELECT * FROM jobs WHERE queue = ? AND available_at <= ? AND reserved_at IS NULL ORDER BY id ASC LIMIT 1 FOR UPDATE");
                $stmt->execute([$queue, time()]);
                $jobRecord = $stmt->fetch();
                
                if ($jobRecord) {
                    // Mark as reserved
                    $updateStmt = $pdo->prepare("UPDATE jobs SET reserved_at = ?, attempts = attempts + 1 WHERE id = ?");
                    $updateStmt->execute([time(), $jobRecord['id']]);
                    $pdo->commit();
                    
                    // Process job
                    $job = unserialize($jobRecord['payload']);
                    echo "Processing job: " . get_class($job) . "\n";
                    
                    try {
                        $manager->processJobSync($job);
                        // If success, delete it
                        $delStmt = $pdo->prepare("DELETE FROM jobs WHERE id = ?");
                        $delStmt->execute([$jobRecord['id']]);
                        echo "Job completed successfully.\n";
                    } catch (Exception $e) {
                        echo "Job failed: " . $e->getMessage() . "\n";
                        // If it fails permanently, processJobSync handles logging and inserting to failed_jobs. 
                        // We still delete it from the active queue.
                        $delStmt = $pdo->prepare("DELETE FROM jobs WHERE id = ?");
                        $delStmt->execute([$jobRecord['id']]);
                    }
                } else {
                    $pdo->commit();
                    sleep(2); // No jobs, sleep before polling again
                }
                
            } catch (Exception $e) {
                if ($pdo->inTransaction()) {
                    $pdo->rollBack();
                }
                echo "Worker Error: " . $e->getMessage() . "\n";
                sleep(5);
            }
        }
        break;

    case 'help':
    default:
        echo "Finzo Database Management CLI (Enterprise BCDR Edition)\n\n";
        echo "Deployment & Versioning:\n";
        echo "  php bin/finzo migrate         Run pending migrations (auto-backs up schema)\n";
        echo "  php bin/finzo rollback        Rollback the last migration batch\n";
        echo "  php bin/finzo reset           Rollback all migrations\n";
        echo "  php bin/finzo seed [type]     Run database seeders (system, dev, testing, demo)\n\n";
        echo "Disaster Recovery (BCDR):\n";
        echo "  php bin/finzo backup [type]   Create an encrypted database backup (full, schema, data)\n";
        echo "  php bin/finzo restore [file]  Restore from an encrypted backup archive\n";
        echo "  php bin/finzo validate        Perform full database integrity verification\n";
        break;
}
