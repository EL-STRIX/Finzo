APP_NAME=Finzo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/Finzo

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finzo_db
DB_USER=root
DB_PASS=

# Session & Cache
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Redis Configuration (Enterprise)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@finzo.com
MAIL_FROM_NAME="Finzo Banking"
