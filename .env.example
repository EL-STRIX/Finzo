APP_NAME=Finzo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/Finzo

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finzo_db
DB_USER=root
DB_PASS=

# Session & Cache
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Redis Configuration (Enterprise)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
SMTP_MAILER=smtp
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_username
SMTP_PASS=your_password
SMTP_ENCRYPTION=tls
SMTP_FROM=noreply@finzo.com
SMTP_FROM_NAME="Finzo Banking"
